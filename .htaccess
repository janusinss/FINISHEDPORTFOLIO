# Disable directory browsing
Options -Indexes

# Protect sensitive files and directories
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "^(patch\.php|composer\.json|package\.json|.*\.md)$">
    Require all denied
</FilesMatch>

# Allow CORS if needed (already handled in PHP, but good for static assets)
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>
